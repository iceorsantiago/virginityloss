# loq-dots: the external repos only provide their own packages.
# Priority 100 = they never replace a Debian version (500), but they do install
# what only exists in them (niri, noctalia...).

Package: *
Pin: origin download.opensuse.org
Pin-Priority: 100

Package: niri xwayland-satellite
Pin: origin download.opensuse.org
Pin-Priority: 500

Package: *
Pin: origin pkg.noctalia.dev
Pin-Priority: 100

Package: noctalia* nickh-archive-keyring
Pin: origin pkg.noctalia.dev
Pin-Priority: 500
