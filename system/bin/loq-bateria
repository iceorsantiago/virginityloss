#!/bin/sh
# Modo conservación de batería del Lenovo LOQ (carga hasta ~80% para alargar su vida).
# Uso: sudo loq-bateria on | off | estado
set -eu
f="$(ls /sys/bus/platform/drivers/ideapad_acpi/*/conservation_mode 2>/dev/null | head -n1 || true)"
[ -n "$f" ] || { echo "No disponible: el módulo ideapad_laptop no expone conservation_mode en este kernel." >&2; exit 1; }
case "${1:-estado}" in
    on)     echo 1 > "$f"; echo "Conservación: activada (tope ~80%)" ;;
    off)    echo 0 > "$f"; echo "Conservación: desactivada (carga al 100%)" ;;
    estado) [ "$(cat "$f")" = 1 ] && echo "Conservación: activada" || echo "Conservación: desactivada" ;;
    *)      echo "Uso: sudo loq-bateria on|off|estado" >&2; exit 2 ;;
esac
