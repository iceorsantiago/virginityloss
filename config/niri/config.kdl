// ==========================================================================
//  loq-dots · niri + Noctalia v5 en Debian 13 · Lenovo LOQ 15ARP9
//  Estética de amane/suzuha (MystiaFin): Catppuccin Mocha, sin bordes ni
//  focus ring, esquinas de 16 px, gaps de 6, sombra suave y ventanas que
//  entran deslizándose. Base de atajos: dotfiles de xMane13.
// ==========================================================================

spawn-at-startup "noctalia"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Captura %Y-%m-%d %H-%M-%S.png"

cursor {
    xcursor-theme "catppuccin-mocha-dark-cursors"
    xcursor-size 24
}

// Pantalla interna: 1920x1080 a 144 Hz. Confirma el nombre con:  niri msg outputs
// niri exige la tasa exacta que lista ese comando: con "@144" no la encuentra y cae a 60 Hz.
output "eDP-1" {
    mode "1920x1080@144.003"
    // Fija: sin esto niri lo recoloca al conectar otro monitor y el orden queda al revés
    position x=0 y=0
    // scale 1.25   // descomenta si prefieres todo más grande
}

// Monitor VGA por adaptador HDMI->VGA ("Analog" en su menú). El adaptador (PNP RGT) dice que
// prefiere 1024x768, pero el panel es 1366x768. Se busca por nombre: otros monitores HDMI no se tocan.
// Está a la DERECHA del portátil en el escritorio: el cursor pasa por el borde derecho.
output "PNP(RGT) 0x1352 0x01010101" {
    mode "1366x768@59.790"
    position x=1920 y=0
}

// ---------------- Entrada ----------------
input {
    keyboard {
        xkb {
            layout "us,latam"
        }
        repeat-delay 300
        repeat-rate 50
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
}

// ---------------- Apariencia ----------------
layout {
    gaps 6
    background-color "transparent"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    default-column-width { proportion 0.7; }

    focus-ring {
        off
    }
    border {
        off
    }

    shadow {
        on
        softness 30
        spread 0
        offset x=0 y=10
        color "#000000e8"
    }
}

overview {
    workspace-shadow {
        off
    }
}

// Wallpaper de Noctalia fijo detrás de los workspaces (no se desplaza al cambiar)
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

animations {
    // Las ventanas suben 240 px mientras aparecen y bajan mientras se van
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec3 c = coords_geo;
                c.y -= (1.0 - p) * 240.0 / size_geo.y;
                return texture2D(niri_tex, (niri_geo_to_tex * c).st) * p;
            }
        "#
    }
    window-close {
        duration-ms 280
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec3 c = coords_geo;
                c.y -= p * 240.0 / size_geo.y;
                return texture2D(niri_tex, (niri_geo_to_tex * c).st) * (1.0 - p);
            }
        "#
    }
}

debug {
    // Para que las notificaciones de Noctalia puedan enfocar ventanas
    honor-xdg-activation-with-invalid-serial
}

// ---------------- Reglas de ventanas ----------------
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id="kitty-scratch"
    open-floating true
    default-column-width { proportion 0.62; }
    default-window-height { proportion 0.62; }
}

window-rule {
    match title="(?i)picture.in.picture"
    open-floating true
    default-column-width { fixed 520; }
    default-window-height { fixed 292; }
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

window-rule {
    match app-id="(?i)(pavucontrol|blueman-manager|org.gnome.Loupe|nm-connection-editor)"
    match title="(?i)(open file|save file|abrir archivo|guardar archivo)"
    open-floating true
}

// >>> blur (niri >= 26.04; el instalador quita este bloque si tu niri no lo soporta)
blur {
    passes 2
    offset 3.0
    noise 0.02
    saturation 1.2
}

window-rule {
    match app-id="^(kitty|kitty-scratch)$"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
// <<< blur

// ---------------- Atajos ----------------
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+Space hotkey-overlay-title="Cambiar idioma del teclado" { switch-layout "next"; }

    // Apps
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Ctrl+Alt+T { spawn "kitty"; }
    Mod+T hotkey-overlay-title="Terminal flotante" { spawn "kitty" "--class=kitty-scratch"; }
    Mod+E hotkey-overlay-title="Archivos" { spawn "nautilus"; }

    // Noctalia
    Mod+Space hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Ctrl+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Centro de control" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+W hotkey-overlay-title="Wallpapers" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Period hotkey-overlay-title="Portapapeles" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+N hotkey-overlay-title="Ajustes de Noctalia" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+X hotkey-overlay-title="Apagar / sesión" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Alt+Tab { spawn "noctalia" "msg" "window-switcher" "hold"; }
    Alt+Shift+Tab { spawn "noctalia" "msg" "window-switcher" "hold" "reverse"; }

    // Ventanas
    Mod+Q repeat=false { close-window; }
    Alt+F4 { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+A repeat=false { toggle-overview; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    // Monitores: Shift = ir al otro monitor, Shift+Ctrl = llevar la ventana allá
    Mod+Shift+Left       { focus-monitor-left; }
    Mod+Shift+Right      { focus-monitor-right; }
    Mod+Shift+H          { focus-monitor-left; }
    Mod+Shift+L          { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Shift+I { move-column-to-workspace-up; }
    Mod+Shift+Tab { focus-workspace-previous; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Multimedia (con el OSD de Noctalia)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    // Capturas
    Print       { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
}

environment {
    QT_QPA_PLATFORM "wayland;xcb"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}
