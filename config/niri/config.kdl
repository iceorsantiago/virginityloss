// ==========================================================================
//  loq-dots · niri + Noctalia v5 on Debian 13 · Lenovo LOQ 15ARP9
//  amane/suzuha look (MystiaFin): Catppuccin Mocha, no borders or
//  focus ring, 16 px corners, gaps of 6, soft shadow and windows that
//  slide in. Keybinding base: xMane13's dotfiles.
// ==========================================================================

spawn-at-startup "noctalia"

prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot %Y-%m-%d %H-%M-%S.png"

cursor {
    xcursor-theme "catppuccin-mocha-dark-cursors"
    xcursor-size 24
}

// Internal screen: 1920x1080 at 144 Hz. Confirm the name with:  niri msg outputs
// niri needs the exact rate that command lists: with "@144" it doesn't find it and falls back to 60 Hz.
output "eDP-1" {
    mode "1920x1080@144.003"
    // Fixed: without this niri repositions it when another monitor is plugged in and the order ends up reversed
    position x=0 y=0
    // scale 1.25   // uncomment if you prefer everything bigger
}

// VGA monitor through an HDMI->VGA adapter ("Analog" in its menu). The adapter (PNP RGT) says it
// prefers 1024x768, but the panel is 1366x768. Matched by name: other HDMI monitors are left alone.
// It sits to the RIGHT of the laptop on the desk: the cursor crosses over the right edge.
output "PNP(RGT) 0x1352 0x01010101" {
    mode "1366x768@59.790"
    position x=1920 y=0
}

// ---------------- Input ----------------
input {
    keyboard {
        xkb {
            layout "us,latam"
        }
        repeat-delay 300
        repeat-rate 50
        numlock
    }
    touchpad {
        tap
        natural-scroll
        dwt
    }
}

// ---------------- Appearance ----------------
layout {
    gaps 6
    background-color "transparent"
    always-center-single-column

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    // Half the screen: two windows fit side by side without touching anything (Super+F to maximize)
    default-column-width { proportion 0.5; }

    focus-ring {
        off
    }
    border {
        off
    }

    shadow {
        on
        softness 30
        spread 0
        offset x=0 y=10
        color "#000000e8"
    }
}

overview {
    workspace-shadow {
        off
    }
}

// Noctalia wallpaper fixed behind the workspaces (doesn't scroll when switching)
layer-rule {
    match namespace="^noctalia-wallpaper"
    place-within-backdrop true
}

animations {
    // Windows rise 240 px as they appear and drop as they go away
    window-open {
        duration-ms 200
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 open_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec3 c = coords_geo;
                c.y -= (1.0 - p) * 240.0 / size_geo.y;
                return texture2D(niri_tex, (niri_geo_to_tex * c).st) * p;
            }
        "#
    }
    window-close {
        duration-ms 280
        curve "ease-out-cubic"
        custom-shader r#"
            vec4 close_color(vec3 coords_geo, vec3 size_geo) {
                float p = niri_clamped_progress;
                vec3 c = coords_geo;
                c.y -= p * 240.0 / size_geo.y;
                return texture2D(niri_tex, (niri_geo_to_tex * c).st) * (1.0 - p);
            }
        "#
    }
}

debug {
    // So Noctalia notifications can focus windows
    honor-xdg-activation-with-invalid-serial
}

// ---------------- Window rules ----------------
window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
}

window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
    default-column-width { fixed 1080; }
    default-window-height { fixed 920; }
}

window-rule {
    match app-id="kitty-scratch"
    open-floating true
    default-column-width { proportion 0.62; }
    default-window-height { proportion 0.62; }
}

window-rule {
    match title="(?i)picture.in.picture"
    open-floating true
    default-column-width { fixed 520; }
    default-window-height { fixed 292; }
    default-floating-position x=24 y=24 relative-to="bottom-right"
}

window-rule {
    match app-id="(?i)(pavucontrol|blueman-manager|org.gnome.Loupe|nm-connection-editor)"
    match title="(?i)(open file|save file|abrir archivo|guardar archivo)"
    open-floating true
}

// >>> blur (niri >= 26.04; the installer removes this block if your niri doesn't support it)
blur {
    passes 2
    offset 3.0
    noise 0.02
    saturation 1.2
}

window-rule {
    match app-id="^(kitty|kitty-scratch)$"
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^noctalia-(bar-[^\"]+|notification|dock|panel|attached-panel|osd)$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace="noctalia-window-switcher"
    background-effect {
        blur true
        xray false
    }
}
// <<< blur

// ---------------- Keybindings ----------------
binds {
    Mod+Shift+Slash { show-hotkey-overlay; }
    Mod+Shift+Space hotkey-overlay-title="Switch keyboard layout" { switch-layout "next"; }

    // Apps
    Mod+Return hotkey-overlay-title="Terminal" { spawn "kitty"; }
    Ctrl+Alt+T { spawn "kitty"; }
    // Toggle: open, hide (it keeps running) and bring it back. See scratch-terminal.sh
    Mod+T hotkey-overlay-title="Floating terminal (show/hide)" { spawn-sh "~/.config/niri/scratch-terminal.sh"; }
    Mod+E hotkey-overlay-title="Files" { spawn "nautilus"; }
    Mod+G hotkey-overlay-title="Tell Guess Who's Back (mic)" { spawn "guess-whos-back" "--speak"; }

    // Noctalia
    Mod+Space hotkey-overlay-title="Launcher" { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Ctrl+Space { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+S hotkey-overlay-title="Control center" { spawn "noctalia" "msg" "panel-toggle" "control-center"; }
    Mod+Shift+W hotkey-overlay-title="Wallpapers" { spawn "noctalia" "msg" "panel-toggle" "wallpaper"; }
    Mod+Period hotkey-overlay-title="Clipboard" { spawn "noctalia" "msg" "panel-toggle" "clipboard"; }
    Mod+N hotkey-overlay-title="Noctalia settings" { spawn "noctalia" "msg" "settings-toggle"; }
    Mod+X hotkey-overlay-title="Power / session" { spawn "noctalia" "msg" "panel-toggle" "session"; }
    Alt+Tab { spawn "noctalia" "msg" "window-switcher" "hold"; }
    Alt+Shift+Tab { spawn "noctalia" "msg" "window-switcher" "hold" "reverse"; }

    // Windows
    Mod+Q repeat=false { close-window; }
    Alt+F4 { close-window; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+W { toggle-column-tabbed-display; }
    Mod+O repeat=false { toggle-overview; }
    Mod+Shift+A repeat=false { toggle-overview; }

    Mod+BracketLeft  { consume-or-expel-window-left; }
    Mod+BracketRight { consume-or-expel-window-right; }
    Mod+Comma        { consume-window-into-column; }

    Mod+Left  { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up    { focus-window-up; }
    Mod+Down  { focus-window-down; }
    Mod+H     { focus-column-left; }
    Mod+L     { focus-column-right; }
    Mod+K     { focus-window-up; }
    Mod+J     { focus-window-down; }

    Mod+Ctrl+Left  { move-column-left; }
    Mod+Ctrl+Right { move-column-right; }
    Mod+Ctrl+Up    { move-window-up; }
    Mod+Ctrl+Down  { move-window-down; }
    Mod+Ctrl+H     { move-column-left; }
    Mod+Ctrl+L     { move-column-right; }
    Mod+Ctrl+K     { move-window-up; }
    Mod+Ctrl+J     { move-window-down; }

    // Monitors: Shift = go to the other monitor, Shift+Ctrl = move the window there
    Mod+Shift+Left       { focus-monitor-left; }
    Mod+Shift+Right      { focus-monitor-right; }
    Mod+Shift+H          { focus-monitor-left; }
    Mod+Shift+L          { focus-monitor-right; }
    Mod+Shift+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Shift+Ctrl+H     { move-column-to-monitor-left; }
    Mod+Shift+Ctrl+L     { move-column-to-monitor-right; }

    Mod+Home { focus-column-first; }
    Mod+End  { focus-column-last; }

    Mod+R       { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+F       { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C       { center-column; }
    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }
    Mod+Shift+Minus { set-window-height "-10%"; }
    Mod+Shift+Equal { set-window-height "+10%"; }

    // Workspaces
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+Shift+5 { move-column-to-workspace 5; }
    Mod+Shift+6 { move-column-to-workspace 6; }
    Mod+Shift+7 { move-column-to-workspace 7; }
    Mod+Shift+8 { move-column-to-workspace 8; }
    Mod+Shift+9 { move-column-to-workspace 9; }
    Mod+U { focus-workspace-down; }
    Mod+I { focus-workspace-up; }
    Mod+Shift+U { move-column-to-workspace-down; }
    Mod+Shift+I { move-column-to-workspace-up; }
    Mod+Shift+Tab { focus-workspace-previous; }
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp   cooldown-ms=150 { focus-workspace-up; }

    // Media keys (with the Noctalia OSD)
    XF86AudioRaiseVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioLowerVolume  allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioMute         allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    // Volume with the touchpad: Super + two-finger swipe up/down (niri doesn't let you rebind
    // the three-finger gesture). With natural-scroll, "ScrollDown" means moving your fingers up.
    Mod+TouchpadScrollDown { spawn "noctalia" "msg" "volume-up" "2"; }
    Mod+TouchpadScrollUp   { spawn "noctalia" "msg" "volume-down" "2"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
    XF86AudioPlay allow-when-locked=true { spawn "playerctl" "play-pause"; }
    XF86AudioNext allow-when-locked=true { spawn "playerctl" "next"; }
    XF86AudioPrev allow-when-locked=true { spawn "playerctl" "previous"; }

    // Screenshots
    Print       { screenshot; }
    Mod+Shift+S { screenshot; }
    Ctrl+Print  { screenshot-screen; }
    Alt+Print   { screenshot-window; }

    Mod+Escape allow-inhibiting=false { toggle-keyboard-shortcuts-inhibit; }
    Mod+Shift+E { quit; }
}

environment {
    QT_QPA_PLATFORM "wayland;xcb"
    ELECTRON_OZONE_PLATFORM_HINT "auto"
}
