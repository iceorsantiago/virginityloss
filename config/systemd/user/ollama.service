# Ollama for the local AI in Guess Who's Back (user install in ~/.local/opt/ollama, no sudo).
# Enabled by steps/50-dots.sh when that binary exists. Loopback only.
[Unit]
Description=Ollama (user install in ~/.local/opt/ollama)
ConditionPathExists=%h/.local/opt/ollama/bin/ollama
After=network-online.target

[Service]
ExecStart=%h/.local/opt/ollama/bin/ollama serve
Environment=OLLAMA_HOST=127.0.0.1:11434
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
